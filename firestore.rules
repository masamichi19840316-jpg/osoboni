rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(roomId) { return /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid); }
    function isMember(roomId) { return signedIn() && exists(memberPath(roomId)); }
    function myRole(roomId) { return get(memberPath(roomId)).data.role; }
    function canEdit(roomId) { return isMember(roomId) && myRole(roomId) in ['owner', 'editor']; }
    function isOwner(roomId) { return isMember(roomId) && myRole(roomId) == 'owner'; }
    function roomOwnerUid(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid; }
    function invite(code) { return get(/databases/$(database)/documents/invites/$(code)); }

    // 各ユーザーが参加している部屋の一覧
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 招待コード
    match /invites/{code} {
      allow get: if signedIn();   // コードを知っている人だけ取得可（一覧は不可）
      allow list: if false;
      allow create: if signedIn() && isOwner(request.resource.data.roomId)
                    && request.resource.data.role in ['editor', 'viewer'];
      allow delete: if signedIn();
    }

    // 記録する方ごとの「部屋」
    match /rooms/{roomId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(roomId);
      allow update: if canEdit(roomId) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner(roomId);

      match /members/{uid} {
        allow read: if isMember(roomId);
        // 自分自身を追加：部屋の作成者、または有効な招待コードを持つ人
        allow create: if signedIn() && request.auth.uid == uid && (
          (roomOwnerUid(roomId) == request.auth.uid && request.resource.data.role == 'owner')
          || (
            request.resource.data.inviteCode is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
            && invite(request.resource.data.inviteCode).data.roomId == roomId
            && invite(request.resource.data.inviteCode).data.role == request.resource.data.role
            && invite(request.resource.data.inviteCode).data.expiresAt > request.time.toMillis()
          )
        );
        // 自分の名前・続柄の変更（役割は変えられない）
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.role == resource.data.role;
        // 退会（自分）または管理者による削除（管理者自身は削除不可）
        allow delete: if signedIn() && resource.data.role != 'owner'
                      && (request.auth.uid == uid || isOwner(roomId));
      }

      match /records/{id} {
        allow read: if isMember(roomId);
        allow create, update, delete: if canEdit(roomId);
      }
      match /reports/{id} {
        allow read: if isMember(roomId);
        allow create, update, delete: if canEdit(roomId);
      }
    }
  }
}
